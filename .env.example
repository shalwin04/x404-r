# ============================================
# x404-r Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Required fields are marked with [REQUIRED]

# ============================================
# Database [REQUIRED]
# ============================================
# CockroachDB connection string
# Local: postgresql://root@localhost:26257/x404r?sslmode=disable
# Cloud: postgresql://user:pass@host:26257/db?sslmode=verify-full
DATABASE_URL=postgresql://root@localhost:26257/x404r?sslmode=disable

# ============================================
# AI Providers (at least one required for AI tasks)
# ============================================
# Gemini API key (recommended - default provider)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API key (optional)
OPENAI_API_KEY=your-openai-api-key

# Anthropic API key (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================
# Server Configuration
# ============================================
# Local server port
PORT=3001

# Node environment
NODE_ENV=development

# Demo mode - skips authentication for development
# [REQUIRED] Set to "false" in production!
DEMO_MODE=true

# ============================================
# Dashboard Configuration
# ============================================
# API URL for frontend to connect to backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# ============================================
# GitHub OAuth (optional - enables user login)
# ============================================
# Create OAuth app at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# ============================================
# Worker Configuration
# ============================================
# Task polling interval (ms)
WORKER_POLL_INTERVAL=5000

# Heartbeat interval (ms)
WORKER_HEARTBEAT_INTERVAL=10000

# Task timeout before reclaim (ms)
TASK_RECLAIM_TIMEOUT=60000

# ============================================
# Metrics Configuration
# ============================================
# Enable metrics collection
METRICS_ENABLED=true

# Metrics flush interval to database (ms)
METRICS_FLUSH_INTERVAL=30000

# ============================================
# Rate Limiting
# ============================================
# Max requests per minute per tenant
RATE_LIMIT_RPM=100

# Max concurrent tasks per tenant
MAX_CONCURRENT_TASKS=10

# ============================================
# AWS Deployment (optional - for CDK)
# ============================================
# AWS region for deployment
AWS_REGION=us-east-1

# Secrets Manager ARNs (production)
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:x404r/database-url
GEMINI_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:x404r/gemini-api-key

# ============================================
# Logging
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable structured JSON logs (for production)
LOG_JSON=false
