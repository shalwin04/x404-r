# CockroachDB connection string
DATABASE_URL=postgresql://user:password@localhost:26257/crashproof?sslmode=disable

# Gemini API key for task execution
GEMINI_API_KEY=your-gemini-api-key

# Dashboard API URL (for connecting to backend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local server port
PORT=3001

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Demo mode (skips auth for development)
# Set to "false" for production
DEMO_MODE=true

# GitHub OAuth (optional - for user authentication)
# Create OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# AWS CDK deployment (optional)
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:crash-proof/database-url
GEMINI_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:crash-proof/gemini-api-key
