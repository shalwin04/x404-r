{
  "name": "@shalwin04/x404r-sdk",
  "version": "1.0.0",
  "description": "The runtime where context is never lost - crash-proof AI agents on CockroachDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./chaos": {
      "types": "./dist/chaos.d.ts",
      "import": "./dist/chaos.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run test:run && npm run build",
    "clean": "rm -rf dist node_modules"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "cockroachdb",
    "distributed",
    "crash-proof",
    "durable-execution",
    "ai-agents",
    "llm",
    "checkpoint",
    "fault-tolerant"
  ],
  "author": "x404-r team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shalwin04/x404-r.git"
  },
  "homepage": "https://github.com/shalwin04/x404-r",
  "bugs": {
    "url": "https://github.com/shalwin04/x404-r/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.10.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
